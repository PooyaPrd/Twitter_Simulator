<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" styleClass="home-root"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ir.pouyapourarshad.ptwitter.view.FollowersListViewController">
    <stylesheets>
        <URL value="@style/HomeStyle.css" />
        <URL value="@style/Account.css" />
        <URL value="@style/SearchStyle.css" />
    </stylesheets>

    <center>
        <VBox styleClass="main-section">
            <HBox alignment="CENTER_LEFT" styleClass="topbar">
                <Label fx:id="title" styleClass="page-title" text="Followers of " />
            </HBox>

            <Separator styleClass="section-separator" />

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="feed-scroll" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox spacing="18.0" styleClass="search-container">
                        <padding>
                            <Insets bottom="24" left="24" right="24" top="20" />
                        </padding>

                        <VBox fx:id="resultsContainer" spacing="14.0">
                            <Label styleClass="search-results-title" text="Results" />

                            <VBox spacing="14.0" styleClass="account-result-card">
                                <HBox alignment="TOP_LEFT" spacing="14.0">
                                    <StackPane maxHeight="56" maxWidth="56" minHeight="56" minWidth="56" styleClass="result-avatar-wrap">
                                        <Circle radius="28" styleClass="result-avatar-circle" />
                                        <Label styleClass="result-avatar-text" text="A" />
                                    </StackPane>

                                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <Label styleClass="result-name" text="Amir Karimi" />
                                            <Label styleClass="result-username" text="/@amir_dev" />
                                        </HBox>

                                        <Label styleClass="result-bio" text="Backend developer, coffee addict, and someone who writes bugs with confidence." wrapText="true" />
                                    </VBox>
                                </HBox>
                            </VBox>

                            <VBox spacing="14.0" styleClass="account-result-card">
                                <HBox alignment="TOP_LEFT" spacing="14.0">
                                    <StackPane maxHeight="56" maxWidth="56" minHeight="56" minWidth="56" styleClass="result-avatar-wrap">
                                        <Circle radius="28" styleClass="result-avatar-circle" />
                                        <Label styleClass="result-avatar-text" text="N" />
                                    </StackPane>

                                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <Label styleClass="result-name" text="Nika Fallah" />
                                            <Label styleClass="result-username" text="/@nika_ui" />
                                        </HBox>

                                        <Label styleClass="result-bio" text="UI/UX designer who loves minimal interfaces, dark themes, and clean product thinking." wrapText="true" />
                                    </VBox>
                                </HBox>
                            </VBox>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
