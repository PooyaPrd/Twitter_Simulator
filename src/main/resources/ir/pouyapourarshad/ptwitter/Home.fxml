<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" styleClass="home-root" stylesheets="@style/HomeStyle.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ir.pouyapourarshad.ptwitter.view.HomeViewController">

    <left>
        <VBox prefWidth="250.0" spacing="18.0" styleClass="sidebar">
            <padding>
                <Insets bottom="28" left="20" right="20" top="28" />
            </padding>

            <Label styleClass="brand-logo" text="P." />

            <VBox spacing="10.0">
                <Button fx:id="sidebarHomeButton" text="⌂  Home">
               <styleClass>
                  <String fx:value="nav-button" />
                  <String fx:value="nav-button-active" />
               </styleClass></Button>
                <Button fx:id="sidebarSearchButton" styleClass="nav-button" text="⌕  Search" />
                <Button fx:id="sidebarProfileButton" styleClass="nav-button" text="☺  Profile" />
                <Button fx:id="sidebarPostNewButton" text="⊕  Post New">
               <styleClass>
                  <String fx:value="nav-button" />
                  <String fx:value="nav-button-active" />
               </styleClass></Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="10.0" styleClass="sidebar-profile-card">
                <HBox spacing="12.0">
                    <StackPane maxHeight="42" maxWidth="42" minHeight="42" minWidth="42" styleClass="mini-avatar-wrap">
                        <Circle fx:id="userProfilePicture" radius="21" style="-fx-fill: BLUE;" />
                    </StackPane>

                    <VBox spacing="2.0">
                        <Label fx:id="userFullName" styleClass="sidebar-name" text="Pouya Dev" />
                        <Label fx:id="userUsername" styleClass="sidebar-username" text="pouya_dev" />
                    </VBox>
                </HBox>

                <Button fx:id="sidebarLogoutButton" styleClass="ghost-button" text="Log out" />
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox styleClass="main-section">
            <HBox alignment="CENTER_LEFT" styleClass="topbar">
                <Label styleClass="page-title" text="Home" />
            </HBox>

            <Separator styleClass="section-separator" />

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="feed-scroll" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox fx:id="postsContainer" spacing="16.0" styleClass="feed-container">
                        <padding>
                            <Insets bottom="24" left="24" right="24" top="20" />
                        </padding>

                        <!-- Post Card 1 -->
                        <VBox spacing="14.0" styleClass="post-card">
                            <HBox spacing="12.0">
                                <StackPane maxHeight="48" maxWidth="48" minHeight="48" minWidth="48" styleClass="post-avatar-wrap">
                                    <Circle radius="24" styleClass="post-avatar-circle" />
                                    <Label styleClass="post-avatar-text" text="A" />
                                </StackPane>

                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <Label styleClass="post-display-name" text="Zahra Zeinali" />
                                        <Label styleClass="post-username" text="Zz" />
                                    </HBox>

                                    <Label styleClass="post-content" text="Working on my Ksocial app at 3AM because deadlines are a social construct." wrapText="true" />

                                    <StackPane prefHeight="170.0" styleClass="post-media-preview">
                                        <Label styleClass="media-preview-text" text="Media Preview" />
                                    </StackPane>

                                    <HBox spacing="24.0" styleClass="post-actions">
                                        <Button styleClass="action-button" text="♡ Like" />
                                        <Button styleClass="action-button" text="↩ Reply" />
                                        <Button styleClass="action-button" text="⇪ Share" />
                                    </HBox>
                                </VBox>
                            </HBox>
                        </VBox>
                  <VBox spacing="14.0" styleClass="post-card">
                     <children>
                        <HBox spacing="12.0">
                           <children>
                              <StackPane maxHeight="48" maxWidth="48" minHeight="48" minWidth="48" styleClass="post-avatar-wrap">
                                 <children>
                                    <Circle radius="24" styleClass="post-avatar-circle" />
                                    <Label styleClass="post-avatar-text" text="A" />
                                 </children>
                              </StackPane>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                       <children>
                                          <Label styleClass="post-display-name" text="Zahra Zeinali" />
                                          <Label styleClass="post-username" text="Zz" />
                                       </children>
                                    </HBox>
                                    <Label styleClass="post-content" text="Working on my Ksocial app at 3AM because deadlines are a social construct." wrapText="true" />
                                    <StackPane prefHeight="170.0" styleClass="post-media-preview">
                                       <children>
                                          <Label styleClass="media-preview-text" text="Media Preview" />
                                       </children>
                                    </StackPane>
                                    <HBox spacing="24.0" styleClass="post-actions">
                                       <children>
                                          <Button styleClass="action-button" text="♡ Like" />
                                          <Button styleClass="action-button" text="↩ Reply" />
                                          <Button styleClass="action-button" text="⇪ Share" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
